# ==============================================================================
# CLONE Platform (.env.local template)
# Copy to .env (or .env.local for compose) and supply real credentials.
# Zero mocked providers: live API keys are required for Phase 2+ live testing.
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. PostgreSQL 18 (matches docker-compose.local.yml on 127.0.0.1:5433)
# ------------------------------------------------------------------------------
POSTGRES_USER=rakazo
POSTGRES_PASSWORD=clone_local_pg_pass
POSTGRES_DB=rakazo
POSTGRES_APP_PASSWORD=clone_local_app_pass
POSTGRES_HOST_PORT=5433

DATABASE_MIGRATION_URL=postgres://rakazo:clone_local_pg_pass@127.0.0.1:5433/rakazo
DATABASE_URL=postgres://rakazo_app:clone_local_app_pass@127.0.0.1:5433/rakazo

# ------------------------------------------------------------------------------
# 2. App Auth, Encryption & Core URLs
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
API_HOST=127.0.0.1

ENCRYPTION_KEY=replace-with-32-byte-hex-encryption-key
CONTENT_ENCRYPTION=on
SECRET_STORE=encrypted
WAKEUP_DRIVER=graphile
AGENT_RUNTIME=pi

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO local S3 for artifacts, media takes & character refs)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=clone-artifacts
OBJECT_STORAGE_PROTOCOL=s3
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=cloneadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=cloneadminsecret
OBJECT_STORAGE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 4. Sandboxes / Computers (Data Analysis & Rakazo Computer Use)
# ------------------------------------------------------------------------------
SANDBOX_PROVIDER=docker
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
SANDBOX_SUPERVISOR_TOKEN=replace-with-32-plus-character-supervisor-token
SCREEN_PROXY_SECRET=replace-with-32-plus-character-screen-proxy-secret

# ------------------------------------------------------------------------------
# 5. Core 5 Day-1 Live Providers (Required for Live V1 Verification)
# ------------------------------------------------------------------------------
# Direct OpenAI (GPT-6.2 Sol/Astra, GPT Image 2.6 Sunburst, Realtime Voice)
OPENAI_API_KEY=

# Direct xAI / Grok (Grok 4.7, Web/X Search, Imagine Image 2.0, Video 1.5/Lite, Grok Voice)
XAI_API_KEY=

# Direct Refuseless (GLM-5.3 Flash Abliterated, GLM-5.3 Abliterated, DeepSeek V4.1 Flash 1017 Abliterated)
REFUSELESS_API_KEY=
REFUSELESS_BASE_URL=https://api.refuseless.com/v1

# Direct fal.ai (Seedance 2.5, Kling 4.0, Seedream 5.5, Nano Banana 2.1, FLUX 3)
FAL_KEY=

# Direct UncensoredLLM (Qwen Image 3, Qwen Edit, Chroma, CyberRealistic XL, Wan 3.0 Video, LTX 2.3 I2V)
UNCENSOREDLLM_API_KEY=
UNCENSOREDLLM_BASE_URL=https://api.uncensoredllm.ai/v1

# ------------------------------------------------------------------------------
# 6. Optional BYOK / Secondary Registry Providers
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VENICE_API_KEY=
RUNWARE_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Local Ollama / vLLM compatible endpoint (explicit opt-in)
RAKAZO_LOCAL_MODELS=
RAKAZO_LOCAL_MODELS_URL=http://127.0.0.1:11434/v1
RAKAZO_LOCAL_MODELS_API_KEY=

# ------------------------------------------------------------------------------
# 7. Rakazo Media & Billing Controls
# ------------------------------------------------------------------------------
MEDIA_GENERATION_PROVIDER=fal
MEDIA_GENERATION_BASE_URL=https://queue.fal.run
MEDIA_GENERATION_API_KEY=
PI_DEFAULT_PROVIDER=openai
PI_DEFAULT_MODEL=gpt-6.2-sol

# Stripe (for hosted workspace subscriptions & credit top-ups)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
